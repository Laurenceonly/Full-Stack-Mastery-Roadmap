      "css": ".ds-nav{font-family:Aptos,\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:10px;width:100%;min-height:44px;padding:12px 10px;border:1px solid var(--violet, #a578ff);background:var(--selected, #21163f);color:var(--ink, #eef2fb);font-size:12px;border-radius:9px;box-shadow:inset 3px 0 var(--violet, #a578ff);cursor:pointer}.ds-nav:hover{background:var(--raised, #111b2a)}.ds-count{margin-left:auto;color:var(--muted, #a0aec5);font-size:10px;font-variant-numeric:tabular-nums}.ds-nav:focus-visible{outline:2px solid var(--blue, #34bdff);outline-offset:3px}"
