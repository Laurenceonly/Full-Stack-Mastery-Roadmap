      "css": ".ds-completed{font-family:Aptos,\"Segoe UI\",sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:38px;padding:11px;border:1px solid var(--success, #1bdfaa);border-radius:8px;color:#fff;background:#09674f;font-size:11px;font-weight:600;cursor:pointer}.ds-completed:hover{filter:brightness(1.15)}.ds-completed:focus-visible{outline:2px solid var(--blue, #34bdff);outline-offset:3px}"
    },
