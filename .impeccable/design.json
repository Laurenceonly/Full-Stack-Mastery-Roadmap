    },
    {
      "name": "Topic guide container",
      "kind": "card",
      "refersTo": "topic-guide",
      "description": "Paper guide surface with title, summary, and section choices.",
      "html": "<section class=\"ds-guide\"><h2>JavaScript</h2><div class=\"ds-tabs\" role=\"group\" aria-label=\"Topic sections\"><button aria-pressed=\"true\">Overview</button><button aria-pressed=\"false\">Resources</button><button aria-pressed=\"false\">Practice</button><button aria-pressed=\"false\">Certificates</button></div><p>JavaScript is the programming language of the web.</p></section>",
